DATABASE_URL=sqlite:///./data/finance.db

# Get one at https://console.anthropic.com/settings/keys
# Optional. Without it everything still works: the tracker, charts, budgets and
# forecast need no key at all, and the AI features answer with the built-in
# demo replies instead of erroring. See AI_DEMO_MODE below.
ANTHROPIC_API_KEY=

# What the AI features do when the Anthropic API cannot be reached.
#   auto   - try the real API, fall back to built-in demo replies (default)
#   always - never call the API. Best for a live demo: instant, and it cannot
#            fail because of wifi, quota or billing
#   off    - no fallback, surface the real error
AI_DEMO_MODE=auto
